# Nexus Memory System Environment Configuration

# Database Configuration
NEXUS_DATABASE_PATH=/home/user/.nexus-memory-system/nexus.db
NEXUS_DATABASE_URL=sqlite:///home/user/.nexus-memory-system/nexus.db
# NEXUS_DATABASE_URL=postgresql://user:password@localhost:5432/nexus

# Server Configuration
NEXUS_HOST=127.0.0.1
NEXUS_PORT=8767
NEXUS_WEB_PORT=8768

# Agent Configuration
NEXUS_DEFAULT_AGENT=general

# Memory Configuration
NEXUS_CONSCIOUS_INGEST=true
NEXUS_AUTO_INGEST=true
NEXUS_MEMORY_SEARCH_LIMIT=10
NEXUS_MAX_MEMORY_SIZE=10000
NEXUS_SPEC_SIMILARITY_THRESHOLD=0.8

# OpenAI Configuration (optional, for enhanced features)
OPENAI_API_KEY=your_openai_api_key_here
NEXUS_OPENAI_MODEL=gpt-3.5-turbo

# ─── Always-On Agent Configuration ───

# LLM Provider (openai, anthropic, gemini, openrouter, groq, zai, minimax, mistral)
NEXUS_LLM_PROVIDER=openai
NEXUS_LLM_MODEL=gpt-4o-mini

# API Key env var name (the agent reads the key from THIS env var)
NEXUS_LLM_API_KEY_ENV=OPENAI_API_KEY

# Override base URL (optional — uses provider default if empty)
# NEXUS_LLM_BASE_URL=

# Agent toggle
NEXUS_AGENT_ENABLED=false
NEXUS_AGENT_NAMESPACE=nexus-agent
NEXUS_AGENT_INBOX_DIR=./inbox
NEXUS_AGENT_CONSOLIDATION_INTERVAL_MINS=30
NEXUS_AGENT_SCAN_INTERVAL_SECS=5

# ─── Provider API Keys (set the one matching your provider) ───
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AI...
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...
# ZAI_API_KEY=...
# MINIMAX_API_KEY=...
# MISTRAL_API_KEY=...

# Embeddings Configuration
NEXUS_EMBEDINGS_MODEL=all-MiniLM-L6-v2
NEXUS_EMBEDDINGS_ENABLED=false

# Debug Configuration
NEXUS_VERBOSE=false
NEXUS_DEBUG=false

# Security Configuration
NEXUS_CORS_ORIGINS=["http://localhost:8768", "http://127.0.0.1:8768"]
NEXUS_API_KEY_REQUIRED=false
NEXUS_API_KEY=your_api_key_here

# Performance Configuration
NEXUS_MAX_CONCURRENT_REQUESTS=100
NEXUS_REQUEST_TIMEOUT=30

# PostgreSQL Configuration (if using PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_password

# Redis Configuration (if using Redis for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0

# Logging Configuration
NEXUS_LOG_LEVEL=INFO
NEXUS_LOG_FILE=/home/user/.nexus-memory-system/logs/nexus.log