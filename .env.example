# Nexus Memory System — Environment Configuration
#
# Copy this file to ~/.config/nexus-memory-system/nexus.env (or source it directly)
# and fill in the values for your setup.
#
# All vars are optional — the CLI ships sensible defaults and only requires
# NEXUS_DATABASE_PATH if you want a non-default database location.

# ─── Database ───
# Path to the SQLite database file
NEXUS_DATABASE_PATH="$HOME/.local/share/nexus-memory-system/nexus.db"

# ─── Server ───
# Host and port for the optional web/API surface
# NEXUS_HOST=127.0.0.1
# NEXUS_PORT=8768

# ─── Sync ───
# Sync policy for cross-agent synchronization (manual, auto, aggressive)
NEXUS_SYNC_POLICY="auto"

# ─── Embeddings ───
# Enable semantic embeddings
# NEXUS_EMBEDDINGS_ENABLED="false"

# Backend: "local" (ONNX) or "openai-compatible" (remote or local runtime)
# NEXUS_EMBEDDING_BACKEND="local"

# Provider profile: "inherit", "openai", "gemini", "openrouter", "vllm", "lmstudio", "llamacpp", "custom"
# NEXUS_EMBEDDING_PROVIDER="local"

# Model name (for remote) or local model identifier
# NEXUS_EMBEDDING_MODEL="all-MiniLM-L6-v2"

# API key env var name (e.g., GEMINI_API_KEY, OPENAI_API_KEY)
# NEXUS_EMBEDDING_API_KEY_ENV=""

# Base URL for remote or local OpenAI-compatible runtimes
# NEXUS_EMBEDDING_BASE_URL="http://127.0.0.1:1234/v1"

# Local ONNX model path
# NEXUS_EMBEDDING_MODEL_PATH="/path/to/all-MiniLM-L6-v2.onnx"
# NEXUS_TOKENIZER_PATH="/path/to/all-MiniLM-L6-v2-tokenizer"

# Dimension and timeout (defaults: 384, 60)
# NEXUS_EMBEDDING_DIMENSION=384
# NEXUS_EMBEDDING_TIMEOUT_SECS=60

# ─── LLM (Agent Generation) ───
# Provider: openai, anthropic, gemini, openrouter, groq, zai, minimax, mistral
# NEXUS_LLM_PROVIDER="openai"
# NEXUS_LLM_MODEL="gpt-4o-mini"

# The agent reads the API key from THIS env var name
# NEXUS_LLM_API_KEY_ENV="OPENAI_API_KEY"

# Override base URL (optional — uses provider default if empty)
# NEXUS_LLM_BASE_URL=""

# ─── Always-On Agent ───
# NEXUS_AGENT_ENABLED="false"
# NEXUS_AGENT_NAMESPACE="nexus-agent"
# NEXUS_AGENT_INBOX_DIR="$HOME/.local/share/nexus-memory-system/inbox"
# NEXUS_AGENT_CONSOLIDATION_INTERVAL_MINS="30"
# NEXUS_AGENT_SCAN_INTERVAL_SECS="5"

# ─── Provider API Keys (set the one matching your provider) ───
# The LLM_API_KEY_ENV or EMBEDDING_API_KEY_ENV above points to one of these
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AI...
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=gsk_...
# ZAI_API_KEY=...
# MINIMAX_API_KEY=...
# MISTRAL_API_KEY=...

# ─── Cognition / Runtime (advanced — all have working defaults) ───
# NEXUS_COGNITION_AUTO_RUNTIME_ENABLED=true
# NEXUS_COGNITION_DERIVE_ENABLED=true
# NEXUS_COGNITION_DIGEST_ENABLED=true
# NEXUS_COGNITION_REFLECT_ENABLED=true
# NEXUS_COGNITION_ACTIVITY_DISTILL_ENABLED=true
# NEXUS_COGNITION_DREAM_ON_SESSION_END=true
# NEXUS_COGNITION_CHECKPOINT_FLUSH_ENABLED=true
# NEXUS_COGNITION_RUNTIME_IDLE_TIMEOUT_SECS=900
# NEXUS_COGNITION_MAX_JOB_BATCH=8
# NEXUS_COGNITION_LEASE_TTL_SECS=120
# NEXUS_COGNITION_REPRESENTATION_MAX_ITEMS=24
# NEXUS_COGNITION_DIGEST_SHORT_TARGET_TOKENS=600
# NEXUS_COGNITION_DIGEST_LONG_TARGET_TOKENS=1800
# NEXUS_COGNITION_DIRECT_ENRICHMENT_TIMEOUT_SECS=8
# NEXUS_COGNITION_ACTIVITY_DISTILL_MIN_EVENTS=8
# NEXUS_COGNITION_ACTIVITY_DISTILL_MAX_EVENTS=60
# NEXUS_COGNITION_INCLUDE_RAW_BY_DEFAULT=false
# NEXUS_COGNITION_SESSION_END_DREAM_TIMEOUT_SECS=8
# NEXUS_COGNITION_RETRY_BUFFER_DRAIN_LIMIT=8
# NEXUS_COGNITION_CONTRADICTION_BELIEF_REVISION_ENABLED=true
# NEXUS_COGNITION_CONTRADICTION_CONFIDENCE_PENALTY=0.15
# NEXUS_COGNITION_MEMORY_DECAY_ENABLED=true
# NEXUS_COGNITION_MEMORY_DECAY_AGE_DAYS=90
# NEXUS_COGNITION_MEMORY_DECAY_ACCESS_BOOST_DAYS=30
# NEXUS_COGNITION_ADAPTIVE_DREAM_ENABLED=true
# NEXUS_COGNITION_ADAPTIVE_DREAM_MIN_INTERVAL_SECS=60
# NEXUS_COGNITION_ADAPTIVE_DREAM_MAX_INTERVAL_SECS=1800
